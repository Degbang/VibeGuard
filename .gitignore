__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.pytest-tmp/
.coverage
htmlcov/
dist/
build/

.env
.DS_Store

# Local scratch Java apps used to manually exercise the CLI - not
# project fixtures, never committed.
my-test-app/
*-test-app/

# Real third-party repos cloned locally for QA/precision testing against
# the actual codebase they came from - not this project's own code, must
# never be committed or redistributed as part of it.
.qa-repos/

# Everything under data/sample_apps/ is real project data (the synthetic
# Layer 4 training corpus, and the growing set of Codex-generated
# evaluation apps) that the trusted model contract and the evaluation
# writeups depend on - it must be tracked, not just a directory
# placeholder, or a fresh clone can't reproduce Layer 4/5 or the logged
# results. Previously only layer4_training/ was explicitly un-ignored,
# which silently dropped every AI-generated sample app added after that
# (caught only when they failed to show up in `git status` before a
# commit) - tracking everything here except build output is the fix,
# not another directory to remember to add by name next time.
!data/sample_apps/
data/sample_apps/**/target/

data/labeled/*
!data/labeled/.gitkeep
# The labelled dataset and its trusted model contract are the actual
# Layer 4 artifacts main.py/evaluation depend on by default - same
# reasoning as above, they must be tracked.
!data/labeled/layer4_projects.json
!data/labeled/layer4_random_forest_contract.json
!data/labeled/human_baseline_survey.csv
